<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RYHMÄROJEKTI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RYHMÄROJEKTI"
    Title="RYHMÄROJEKTI">

    <ShellContent
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, *"
              Padding="8"
              BackgroundColor="LightGray">
            <Button Text="Mökkien hallinta"
                    FlyoutItem.IsVisible="True"/>
            <Button Grid.Column="1"
                    Text="Alueiden hallinta"
                    FlyoutItem.IsVisible="True"/>
            <Button Grid.Column="2"
                    Text="Asiakasvarausten hallinta"
                    FlyoutItem.IsVisible="True"/>
            <Button Grid.Column="3"
                    Text="Laskujen hallinta"
                    FlyoutItem.IsVisible="True"/>
            <Button Grid.Column="4"
                    Text="Palveluiden hallinta"
                    FlyoutItem.IsVisible="True"/>
        </Grid>
    </Shell.TitleView>

</Shell>
