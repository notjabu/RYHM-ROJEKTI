<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RYHMÄROJEKTI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RYHMÄROJEKTI"
    xmlns:views="clr-namespace:RYHMÄROJEKTI.views"
    Title="RYHMÄROJEKTI">

    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">
        <Tab Title="Etusivu">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Mökkien hallinta">
            <ShellContent ContentTemplate="{DataTemplate views:MokkiPage}" Route="MokkiPage"/>
        </Tab>
    </FlyoutItem>

</Shell>
