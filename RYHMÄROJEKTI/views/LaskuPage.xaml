<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RYHMÄROJEKTI.views.LaskuPage"
             Title="Laskujen hallinta">

    <Grid ColumnDefinitions="Auto, *, 2*"
          Padding="10"
          ColumnSpacing="15">

        <!-- Napit -->
        <VerticalStackLayout Grid.Column="0"
                             Spacing="10"
                             VerticalOptions="Start"
                             WidthRequest="150">

            <SearchBar Placeholder="Hae laskuja"
                       Margin="0,0,0,10"/>

            <Button Text="Lisää lasku"
                    Clicked="LisaaLasku_Clicked"
                    BackgroundColor="#512BD4"
                    TextColor="White"/>

            <Button Text="Muokkaa"
                    Clicked="Muokkaa_Clicked"
                    BackgroundColor="#f0f0f0"
                    TextColor="Black"/>

            <Button Text="Poista"
                    Command="{Binding PoistaLaskuCommand}"
                    BackgroundColor="#E74C3C"
                    TextColor="White"/>
        </VerticalStackLayout>

        <!-- Laskulista -->
        <VerticalStackLayout Grid.Column="1" Spacing="10">

            <Label Text="Kaikki laskut"
                   FontAttributes="Bold"
                   FontSize="16"/>

            <ListView ItemsSource="{Binding Laskut}"
                      SelectedItem="{Binding ValittuLasku}"
                      SelectionMode="Single"
                      HasUnevenRows="True">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="10" ColumnDefinitions="*">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Otsikko}" FontAttributes="Bold"/>
                                    <Label Text="{Binding SummaText}" FontSize="12" TextColor="Gray"/>
                                </VerticalStackLayout>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </VerticalStackLayout>

        <!-- Tietoikkuna -->
        <ScrollView Grid.Column="2">
            <VerticalStackLayout Spacing="10"
                                 Padding="10"
                                 IsVisible="{Binding ValittuLasku, Converter={StaticResource NullToBoolConverter}}">

                <Label Text="Laskun tiedot"
                       FontAttributes="Bold"
                       FontSize="18"
                       Margin="0,10,0,5"/>

                <Label Text="Lasku ID:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuLasku.Id}" IsReadOnly="True"/>

                <Label Text="Varaus ID:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuLasku.VarausId}" IsReadOnly="True"/>

                <Label Text="Asiakas:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuLasku.AsiakasNimi}" IsReadOnly="True"/>

                <Label Text="Mökki:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuLasku.MokkiNimi}" IsReadOnly="True"/>

                <Label Text="Summa (€):" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuLasku.Summa}" IsReadOnly="True"/>

                <Label Text="ALV (%):" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuLasku.Alv}" IsReadOnly="True"/>

                <Label Text="Maksettu (€):" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuLasku.MaksettuText}" IsReadOnly="True"/>

                <Label Text="Maksamatta (€):" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuLasku.MaksamattaText}" IsReadOnly="True"/>

                <Label Text="Varattu pvm:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuLasku.VarattuPvm}" IsReadOnly="True"/>

                <Label Text="Alkupvm:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuLasku.VarattuAlkuPvm}" IsReadOnly="True"/>

                <Label Text="Loppupvm:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuLasku.VarattuLoppuPvm}" IsReadOnly="True"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>