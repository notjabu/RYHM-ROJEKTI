<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RYHMÄROJEKTI.ViewModels"
             x:Class="RYHMÄROJEKTI.views.AsiakasPage"
             Title="Asiakasrekisteri">

    <ContentPage.BindingContext>
        <vm:AsiakasViewModel />
    </ContentPage.BindingContext>

    <Grid ColumnDefinitions="300, *" Padding="10" ColumnSpacing="15">

        <VerticalStackLayout Grid.Column="0" Spacing="10">
            <Label Text="Asiakkaat" FontSize="20" FontAttributes="Bold" />

            <ListView ItemsSource="{Binding Asiakkaat}" 
                      SelectedItem="{Binding ValittuAsiakas}"
                      HeightRequest="400">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextCell Text="{Binding KokoNimi}" Detail="{Binding Sahkoposti}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Text="Lisää uusi asiakas" Command="{Binding LisaaAsiakasCommand}" BackgroundColor="Blue" TextColor="White" />
            <Button Text="Poista valittu" Command="{Binding PoistaAsiakasCommand}" BackgroundColor="Red" TextColor="White" />
        </VerticalStackLayout>

        <ScrollView Grid.Column="1" BackgroundColor="#F5F5F5" Padding="15">
            <VerticalStackLayout Spacing="10">
                <Label Text="Asiakkaan tiedot" FontSize="18" FontAttributes="Bold" />

                <Label Text="Etunimi" />
                <Entry Text="{Binding ValittuAsiakas.Etunimi}" />

                <Label Text="Sukunimi" />
                <Entry Text="{Binding ValittuAsiakas.Sukunimi}" />

                <Label Text="Sähköposti" />
                <Entry Text="{Binding ValittuAsiakas.Sahkoposti}" Keyboard="Email" />

                <Label Text="Puhelin" />
                <Entry Text="{Binding ValittuAsiakas.Puhelinnro}" Keyboard="Telephone" />

                <Label Text="Osoite" />
                <Entry Text="{Binding ValittuAsiakas.Lahiosoite}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>