<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RYHMÄROJEKTI.views.AsiakasPage"
             Title="Asiakkaiden hallinta">

    <Grid ColumnDefinitions="Auto, *, 2*"
          Padding="10"
          ColumnSpacing="15">

        <!-- Lisää, muokkaa poista ja haku toiminnot -->
        <VerticalStackLayout Grid.Column="0"
                             Spacing="10"
                             WidthRequest="150">

            <SearchBar Placeholder="Hae asiakkaita"
                       Margin="0,0,0,10"/>

            <Button Text="Lisää uusi"
                    BackgroundColor="#512BD4"
                    TextColor="White"/>

            <Button Text="Muokkaa"
                    BackgroundColor="#f0f0f0"
                    TextColor="Black"/>

            <Button Text="Poista"
                    BackgroundColor="#E74C3C"
                    TextColor="White"/>
        </VerticalStackLayout>

        <!-- Asiakkaat listattuna (Kaikki asiakkaat) -->
        <VerticalStackLayout Grid.Column="1" Spacing="10">

            <Label Text="Kaikki asiakkaat"
                   FontAttributes="Bold"
                   FontSize="16"/>

            <ListView ItemsSource="{Binding Asiakkaat}"
                      SelectedItem="{Binding ValittuAsiakas}"
                      SelectionMode="Single"
                      HasUnevenRows="True">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="10"
                                  ColumnDefinitions="*"
                                  ColumnSpacing="10">

                                <!-- Display name -->
                                <Label Text="{Binding Nimi}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </VerticalStackLayout>

        <!-- asiakkaiden tiedot -->
        <ScrollView Grid.Column="2">
            <VerticalStackLayout Spacing="10"
                                 Padding="10"
                                 IsVisible="{Binding ValittuAsiakas, Converter={StaticResource NullToBoolConverter}}">

                <Label Text="Asiakkaan tiedot"
                       FontAttributes="Bold"
                       FontSize="18"
                       Margin="0,10,0,5"/>

                <Label Text="Nimi" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuAsiakas.Nimi}" IsReadOnly="True"/>

                <Label Text="Sähköposti" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuAsiakas.Email}" IsReadOnly="True"/>

                <Label Text="Puhelin" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuAsiakas.Puhelin}" IsReadOnly="True"/>

                <Label Text="Huomautukset" FontAttributes="Bold"/>
                <Editor Text="{Binding ValittuAsiakas.Huomautukset}"
                        HeightRequest="120"
                        IsReadOnly="True"/>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>