<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RYHMÄROJEKTI.views.AluePage"
             Title="Alueiden hallinta">

    <Grid ColumnDefinitions="Auto, *, 2*"
          Padding="10"
          ColumnSpacing="15">

        <!-- Vasen palsta: Haku ja toiminnot -->
        <VerticalStackLayout Grid.Column="0"
                            Spacing="10"
                            WidthRequest="150">

            <SearchBar Placeholder="Hae alueita"
                       Margin="0,0,0,10"
                       TextChanged="SearchBar_TextChanged" />

            <Button Text="Lisää alue" 
                    Command="{Binding LisaaAlueCommand}"
                    Clicked="LisaaAlue_Clicked"
                    BackgroundColor="#512BD4"
                    TextColor="White"/>

            <!-- Muokkaa button: temporary debug version without Command -->
            <Button Text="Muokkaa valittua"
                    Clicked="Muokkaa_Clicked"
                    BackgroundColor="#f0f0f0"
                    TextColor="Black"/>

            <Button Text="Poista valittu" 
                    Command="{Binding PoistaAlueCommand}"
                    BackgroundColor="Red"
                    TextColor="White"/>
        </VerticalStackLayout>

        <!-- Keskellä: Alueluettelo -->
        <VerticalStackLayout Grid.Column="1" Spacing="10">

            <Label Text="Kaikki alueet" 
                   FontAttributes="Bold" 
                   FontSize="16"/>

            <ListView ItemsSource="{Binding Alueet}"
                      SelectedItem="{Binding ValittuAlue}"
                      SelectionMode="Single"
                      HasUnevenRows="True">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="10" 
                                  ColumnDefinitions="Auto,*" 
                                  ColumnSpacing="10">

                                <!-- Pieni thumbnail -->
                                <Frame Grid.Column="0" 
                                       WidthRequest="40" 
                                       HeightRequest="40" 
                                       CornerRadius="20"
                                       IsClippedToBounds="True">
                                    <Image Source="{Binding Kuva}" 
                                           Aspect="AspectFill"/>
                                </Frame>

                                <!-- Nimi -->
                                <Label Grid.Column="1" 
                                       Text="{Binding Nimi}" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </VerticalStackLayout>

        <!-- Oikea palsta: Valitun alueen täydet tiedot -->
        <ScrollView Grid.Column="2">
            <VerticalStackLayout Spacing="10"
                                 Padding="10"
                                 IsVisible="{Binding ValittuAlue, Converter={StaticResource NullToBoolConverter}}">

                <!-- Tiedot -->
                <Label Text="Alueen tiedot" 
                       FontAttributes="Bold" 
                       FontSize="18"
                       Margin="0,10,0,5"/>

                <Label Text="Nimi:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuAlue.Nimi}" IsReadOnly="True"/>

                <Label Text="Sijainti:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuAlue.Sijainti}" IsReadOnly="True"/>

                <Label Text="Postinumero:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuAlue.Postinumero}" IsReadOnly="True"/>

                <Label Text="Kuvaus:" FontAttributes="Bold"/>
                <Editor Text="{Binding ValittuAlue.Kuvaus}" 
                        HeightRequest="100"
                        IsReadOnly="True"/>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>