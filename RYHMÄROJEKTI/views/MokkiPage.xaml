<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RYHMÄROJEKTI.views.MokkiPage"
             Title="MokkiPage">
    <Grid ColumnDefinitions="Auto, *,2*"
          Padding="2"
          ColumnSpacing="10">
        <!-- Napit -->
        <VerticalStackLayout Grid.Column="0"
                             Spacing="10"
                             VerticalOptions="Start">

            <SearchBar Placeholder="Hae mökkejä"
                Margin="5" 
                Grid.Row="0"
                />

            <Button Text="Lisää Mökki" 
                Command="{Binding LisaaMokkiCommand}" 
                Margin="5" 
                Grid.Row="1"
                />

            <Button Text="Muokkaa valittua" 
                Command="{Binding MuokkaaMokkiaCommand}" 
                Margin="5" 
                Grid.Row="2"
                />

            <Button Text="Poista valittu mökki"
                    BackgroundColor="Red"
                    TextColor="White"
                Command="{Binding PoistaMokkiCommand}" 
                Margin="5" 
                Grid.Row="3"
                />
        </VerticalStackLayout>


        <!-- Listan järjestys -->
        <ListView x:Name="MokitListView" 
                  Grid.Column="1" 
                  ItemsSource="{Binding Mokit}" 
                  SelectedItem="{Binding ValittuMokki}"
                  SelectionMode="Single">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid ColumnDefinitions="*,*">

                            <!-- Korjattu binding: käytä Mokki-luokan propertyja -->
                            <Label Grid.Column="0" 
                                   Text="{Binding Nimi}" 
                                   FontAttributes="Bold" 
                                   />

                            <Label Grid.Column="1" 
                                   Text="{Binding Postitoimipaikka}" 
                                   />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Tietoikkuna -->
        <StackLayout Grid.Column="2"
                     IsVisible="{Binding ValittuMokki, Converter={StaticResource NullToBoolConverter}}">

            <Frame HeightRequest="200"
        CornerRadius="10"
        IsClippedToBounds="True">
                <Grid>
                    <Image Source="{Binding ValittuMokki.Kuva}" 
                Aspect="AspectFill"/>
                    <Label Text="Ei kuvaa" 
                IsVisible="{Binding ValittuMokki.Kuva, Converter={StaticResource NullToBoolConverter}}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                TextColor="Gray"/>
                </Grid>
            </Frame>

            <Label Text="Nimi"/>
            <Entry Text="{Binding ValittuMokki.Nimi}"/>

            <Label Text="Katuosoite"/>
            <Entry Text="{Binding ValittuMokki.Katuosoite}"/>

            <Label Text="Postinumero"/>
            <Entry Text="{Binding ValittuMokki.Postinumero}"/>

            <Label Text="Postitoimipaikka"/>
            <Entry Text="{Binding ValittuMokki.Postitoimipaikka}"/>

            <Label Text="Kuvaus"/>
            <Entry Text="{Binding ValittuMokki.Kuvaus}"/>

        </StackLayout>
    </Grid>
</ContentPage>