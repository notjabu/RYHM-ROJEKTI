<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RYHMÄROJEKTI.views.MokkiPage"
             Title="Mökit">
    <Grid ColumnDefinitions="Auto, *,2*"
          Padding="10"
          ColumnSpacing="15">
        <!-- Napit -->
        <VerticalStackLayout Grid.Column="0"
                             Spacing="10"
                             VerticalOptions="Start"
                             WidthRequest="150">

            <SearchBar Placeholder="Hae mökkejä"
                Margin="0,0,0,10"/>

            <Button Text="Lisää mökki" 
                Clicked="LisaaMokki_Clicked"
                BackgroundColor="#512BD4"
                TextColor="White"/>

            <Button Text="Muokkaa" 
                Clicked="Muokkaa_Clicked"
                BackgroundColor="#f0f0f0"
                TextColor="Black"/>

            <Button Text="Poista"
                    BackgroundColor="Red"
                    TextColor="White"
                Command="{Binding PoistaMokkiCommand}"/>
        </VerticalStackLayout>

        <!-- Mökkien lista -->
        <VerticalStackLayout Grid.Column="1" Spacing="10">

            <Label Text="Kaikki mökit"
                   FontAttributes="Bold"
                   FontSize="16"/>

            <ListView ItemsSource="{Binding Mokit}" 
                      SelectedItem="{Binding ValittuMokki}"
                      SelectionMode="Single"
                      HasUnevenRows="True">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="10"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10">

                                <Frame Grid.Column="0" 
                                       WidthRequest="40" 
                                       HeightRequest="40" 
                                       CornerRadius="20"
                                       IsClippedToBounds="True">
                                    <Image Source="{Binding Kuva}" 
                                           Aspect="AspectFill"/>
                                </Frame>

                                <Label Grid.Column="1" 
                                       Text="{Binding Mokkinimi}" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </VerticalStackLayout>

        <!-- Tietoikkuna -->
        <ScrollView Grid.Column="2">
            <VerticalStackLayout Spacing="10"
                                 Padding="10"
                                 IsVisible="{Binding ValittuMokki, Converter={StaticResource NullToBoolConverter}}">

                <Label Text="Mökin tiedot"
                       FontAttributes="Bold"
                       FontSize="18"
                       Margin="0,10,0,5"/>

                <Label Text="Nimi:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuMokki.Mokkinimi}" IsReadOnly="True"/>

                <Label Text="Katuosoite:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuMokki.Katuosoite}" IsReadOnly="True"/>

                <Label Text="Postinumero:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuMokki.Postinro}" IsReadOnly="True"/>

                <Label Text="Postitoimipaikka:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuMokki.Toimipaikka}" IsReadOnly="True"/>

                <Label Text="Hinta (€/yö):" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuMokki.Hinta}" IsReadOnly="True"/>

                <Label Text="Henkilömäärä:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuMokki.Henkilomaara}" IsReadOnly="True"/>

                <Label Text="Varustelu:" FontAttributes="Bold"/>
                <Editor Text="{Binding ValittuMokki.Varustelu}" HeightRequest="80" IsReadOnly="True"/>

                <Label Text="Kuvaus:" FontAttributes="Bold"/>
                <Editor Text="{Binding ValittuMokki.Kuvaus}" HeightRequest="100" IsReadOnly="True"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>