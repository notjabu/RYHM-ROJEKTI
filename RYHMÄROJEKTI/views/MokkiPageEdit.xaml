<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RYHMÄROJEKTI.views.MokkiPageEdit"
             Title="Mökin lisäys / muokkaus">
    
    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="10">
            <Image HeightRequest="200" Aspect="AspectFill" Source="{Binding Kuva}" />
            <Button Text="Valitse kuva" Clicked="OnPickImageClicked" />
            
            <Label Text="Osoite" FontAttributes="Bold" />
            
            <Entry x:Name="KatuEntry" Placeholder="Katuosoite" />
            
            <Entry x:Name="PostinumeroEntry" Placeholder="Postinumero" />
            
            <Entry x:Name="PostitoimipaikkaEntry" Placeholder="Postitoimipaikka" />
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>