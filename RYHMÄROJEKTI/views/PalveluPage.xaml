<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RYHMÄROJEKTI.views"
             x:Class="RYHMÄROJEKTI.views.PalveluPage"
             Title="PalveluPage">

    <Grid ColumnDefinitions="Auto, *, 2*"
          Padding="10"
          ColumnSpacing="15">

        <!-- Vasen palsta: Haku ja toiminnot -->
        <VerticalStackLayout Grid.Column="0"
                            Spacing="10"
                            WidthRequest="150">

            <SearchBar Placeholder="Hae palveluita"
                       Margin="0,0,0,10"/>

            <Button Text="Lisää palvelu" 
                    Command="{Binding LisaaPalveluCommand}"
                    BackgroundColor="#512BD4"
                    TextColor="White"/>

            <Button Text="Muokkaa valittua" 
                    BackgroundColor="#f0f0f0"
                    Pressed="MuokkaaPalveluClicked"/>

            <Button Text="Poista valittu" 
                    Command="{Binding PoistaPalveluCommand}"
                    BackgroundColor="Red"
                    TextColor="White"/>
        </VerticalStackLayout>

        <!-- Keskella: Palveluluettelo -->
        <VerticalStackLayout Grid.Column="1" Spacing="10">

            <Label Text="Kaikki Palvelut" 
                   FontAttributes="Bold" 
                   FontSize="16"/>

            <!-- Header row for list columns -->
            <Grid ColumnDefinitions="*, Auto" Padding="0" Margin="0,0,0,2">
                <Label Text="Palvelu"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
                <Label Text="Hinta"
                       Grid.Column="1"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalOptions="End"/>
            </Grid>

            <ListView ItemsSource="{Binding Palvelut}"
                      SelectedItem="{Binding ValittuPalvelu}"
                      SelectionMode="Single"
                      HasUnevenRows="True">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="10" ColumnDefinitions="*, Auto">
                                <Label Text="{Binding Nimi}" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                                <Label Text="{Binding HintaFormatted}" 
                                       Grid.Column="1"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"
                                       FontAttributes="Italic"
                                       FontSize="12"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </VerticalStackLayout>

        <!-- Oikea palsta: Valitun palvelun taydet tiedot -->
        <ScrollView Grid.Column="2">
            <VerticalStackLayout Spacing="10"
                                 Padding="10">

                <!-- Tiedot -->
                <Label Text="Palvelun tiedot" 
                       FontAttributes="Bold" 
                       FontSize="18"
                       Margin="0,10,0,5"/>

                <Label Text="Nimi:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuPalvelu.Nimi, TargetNullValue=''}" IsReadOnly="True"/>

                <Label Text="Sijainti:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuPalvelu.Sijainti, TargetNullValue=''}" IsReadOnly="True"/>

                <Label Text="Kuvaus:" FontAttributes="Bold"/>
                <Editor Text="{Binding ValittuPalvelu.Kuvaus, TargetNullValue=''}" 
                        HeightRequest="100"
                        IsReadOnly="True"/>

                <Label Text="Hinta:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuPalvelu.HintaFormatted, TargetNullValue=''}" IsReadOnly="True"/>

                <Label Text="ALV:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuPalvelu.AlvFormatted, TargetNullValue=''}" IsReadOnly="True"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>