<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RYHMÄROJEKTI.views"
             x:Class="RYHMÄROJEKTI.views.PalveluPage"
             Title="PalveluPage">

    <Grid ColumnDefinitions="Auto, *, 2*"
          Padding="10"
          ColumnSpacing="15">

        <!-- Vasen palsta: Haku ja toiminnot -->
        <VerticalStackLayout Grid.Column="0"
                            Spacing="10"
                            WidthRequest="150">

            <SearchBar Placeholder="Hae palveluita"
                       Margin="0,0,0,10"
                       TextChanged="SearchBar_TextChanged"/>

            <Button Text="Lisää uusi" 
                    Command="{Binding LisaaPalveluCommand}"
                    BackgroundColor="#512BD4"
                    TextColor="White"/>

            <Button Text="Muokkaa" 
                    Pressed="MuokkaaPalveluClicked"/>

            <Button Text="Poista" 
                    Command="{Binding PoistaPalveluCommand}"
                    BackgroundColor="#E74C3C"
                    TextColor="White"/>
        </VerticalStackLayout>

        <!-- Keskellä: Palveluluettelo -->
        <VerticalStackLayout Grid.Column="1" Spacing="10">

            <Label Text="Kaikki Palvelut" 
                   FontAttributes="Bold" 
                   FontSize="16"/>

            <ListView ItemsSource="{Binding Palvelut}"
                      SelectedItem="{Binding ValittuPalvelu}"
                      SelectionMode="Single"
                      HasUnevenRows="True">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="10" ColumnDefinitions="*, Auto">
                                <Label Text="{Binding Nimi}" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                                <Label Text="{Binding HintaFormatted}" 
                                       Grid.Column="1"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"
                                       FontAttributes="Italic"
                                       FontSize="12"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </VerticalStackLayout>

        <!-- Oikea palsta: Valitun palvelun täydet tiedot -->
        <ScrollView Grid.Column="2"
                    IsVisible="{Binding HasValittuPalvelu}">
            <VerticalStackLayout Spacing="10"
                                 Padding="10">

                <!-- Tiedot -->
                <Label Text="Palvelun tiedot" 
                       FontAttributes="Bold" 
                       FontSize="18"
                       Margin="0,10,0,5"/>

                <Label Text="Nimi:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuPalvelu.Nimi}" IsReadOnly="True"/>

                <Label Text="Sijainti:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuPalvelu.Sijainti}" IsReadOnly="True"/>

                <Label Text="Kuvaus:" FontAttributes="Bold"/>
                <Editor Text="{Binding ValittuPalvelu.Kuvaus}" 
                        HeightRequest="100"
                        IsReadOnly="True"/>

                <Label Text="Hinta:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuPalvelu.HintaFormatted}" IsReadOnly="True"/>

                <Label Text="ALV:" FontAttributes="Bold"/>
                <Entry Text="{Binding ValittuPalvelu.AlvFormatted}" IsReadOnly="True"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>